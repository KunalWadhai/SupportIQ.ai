# ─── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Local Docker Postgres
DATABASE_URL=postgresql://supportiq:supportiq_dev_password@localhost:5432/supportiq

# Neon (production on Render) — use BOTH URLs from Neon dashboard:
# DATABASE_URL = pooled connection (-pooler host), append ?sslmode=require
# DIRECT_DATABASE_URL = direct connection (no -pooler), append ?sslmode=require
# Example:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/supportiq_ai?sslmode=require
# DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/supportiq_ai?sslmode=require

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:supportiq_redis_password@localhost:6379

# ─── Qdrant Vector DB ─────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=supportiq_qdrant_key

# ─── File Storage ─────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: minio (dev) | s3 (production)
# If unset: development → MinIO, production + AWS_S3_BUCKET → S3
STORAGE_PROVIDER=minio

# MinIO — used in development / docker-compose
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=supportiq_minio
MINIO_SECRET_KEY=supportiq_minio_secret
MINIO_BUCKET=supportiq-docs

# AWS S3 — used in production (Render)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-2
AWS_S3_BUCKET=supportiq-ai

# ─── Services ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:3001

# ─── App Config ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS=http://localhost:3000
