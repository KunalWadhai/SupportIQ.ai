# ─── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://supportiq:supportiq_dev_password@localhost:5432/supportiq

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:supportiq_redis_password@localhost:6379

# ─── Qdrant Vector DB ─────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=supportiq_qdrant_key

# ─── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=supportiq_minio
MINIO_SECRET_KEY=supportiq_minio_secret
MINIO_BUCKET=supportiq-docs

# ─── Services ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:3001

# ─── App Config ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
